{
  "name": "first-steps",
  "private": true,
  "description": "Function calling with Jev: an AG-UI server and a CopilotKit client",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "start:server": "npm --prefix server start",
    "start:client": "npm --prefix client start",
    "dev": "concurrently --names server,client --prefix-colors blue,green npm:dev:server npm:start:client",
    "start:all": "concurrently --names server,client --prefix-colors blue,green npm:start:server npm:start:client"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
